# Apprentice - Configuration Example

# Mode: 'preview' (uses deterministic fixtures, no keys/downloads required)
#       'connected' (uses local models and real supervisor API)
APP_MODE=preview

# Local server binding
HOST=127.0.0.1
PORT=8000

# Supervisor LLM Configuration (for Connected Mode)
# Supported providers: gemini, anthropic
# Claude example: SUPERVISOR_PROVIDER=anthropic and SUPERVISOR_MODEL=claude-sonnet-5-5
SUPERVISOR_PROVIDER=gemini
SUPERVISOR_MODEL=gemini-3.8-flash
SUPERVISOR_API_KEY=

# Local Model Configuration (for Connected Mode)
# Path to local weights / GGUF, or URL of running endpoint (e.g., http://localhost:11434)
LOCAL_MODEL_PATH=
LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434
LOCAL_MODEL_NAME=

# Training Backend
# e.g., 'peft_lora', 'mock', 'unconfigured'
TRAINING_BACKEND=mock
